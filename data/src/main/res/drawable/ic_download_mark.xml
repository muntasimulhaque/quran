<?xml version="1.0" encoding="utf-8"?>
<!-- The download service's mark: one stroke down into a shallow tray, drawn
     on the same 24 unit grid as the app's other small marks. The shade reads
     only the alpha channel, so it is one white stroke and no ground. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M12,3 L12,14 M7,9 L12,14 L17,9 M5,20 L19,20"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
