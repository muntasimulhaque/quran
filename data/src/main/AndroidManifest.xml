<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The one transfer that outlives the window. It is a dataSync service:
         the reader's tap starts it, the notification carries its progress and
         its cancel, and it stops when the queue is empty. The app's permission
         law names FOREGROUND_SERVICE_DATA_SYNC in its own manifest. -->
    <application>
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:targetApi="29" />
    </application>
</manifest>
