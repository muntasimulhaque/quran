    <!-- The question before a download the reader waited for is taken away. A
         file under 20 MB goes on one tap; a surah's recitation, which took
         minutes and cannot be brought back without another download, is asked
         about (owner decision, 19.1). -->
    <string name="remove_download_sheet_name">Remove download</string>
    <string name="remove_download_title">Remove %1$s?</string>
    <string name="remove_download_body">It is %1$s of audio, and removing it cannot be undone. Playing the ayah again downloads it again.</string>
    <string name="remove_download_keep">Keep</string>

    <!-- Add and Download are two verbs on purpose, and this is the rule they
         keep (owner decision, 19.1). A pack is added: it is a lasting
         choice in a list, the thing is on this device or it is not, and the row
         that carries it has a Remove at the other end. A sound is downloaded:
         it is a transfer, with a size before it starts and a percent while it
         runs, and it belongs to the pill and to the offer. A reader never adds
         a surah and never downloads a translation. See `playback_download` in
         feature-playback for the other half. -->
