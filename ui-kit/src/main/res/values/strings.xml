<?xml version="1.0" encoding="utf-8"?>
<!--
     The reciters, named the way a reader says them, the app's own packs, and
     the size units a download prints. The names live here because the pill,
     the offer, the settings lists, the ayah card, and the search results all
     draw them, and a Bangla reader must not meet a Latin name in one place
     and a Bengali one in another, nor an English unit beside a Bengali
     number.
-->
<resources>
    <string name="reciter_minshawi">Minshawi</string>
    <string name="reciter_husary">Husary</string>
    <string name="pack_name_quran_text">Quran text</string>
    <string name="pack_name_saheeh_international">Saheeh International</string>
    <string name="pack_name_al_bayan">Al-Bayan Simple Translation</string>
    <string name="pack_name_ibn_kathir">Ibn Kathir</string>
    <string name="pack_name_word_by_word">Word meanings</string>
    <!-- The size units a reader meets beside a download or a pack. The digits
         beside them already follow the interface's own language, and the unit
         is a word of that language too (owner decision, this session). -->
    <string name="unit_kb">KB</string>
    <string name="unit_mb">MB</string>
    <!-- The one word a removal's Snackbar offers back. It lives here because
         the reading and Browse both draw the same undo action. -->
    <string name="action_undo">Undo</string>

    <!-- The one state a door speaks when it opens or closes. A row that
         unfolds says so in the same words wherever it stands. -->
    <string name="door_expanded">Expanded</string>
    <string name="door_collapsed">Collapsed</string>

    <!-- The app's one failure vocabulary: one sentence for one cause, drawn
         by every surface that can fail, so a download that dies in the pill
         says the same words as the row in Settings that asked for it. The
         word list keeps the one sentence that names its subject, because
         what will not fit is the whole point of that row. -->
    <string name="failure_download">Could not download. Check your connection.</string>
    <string name="failure_storage">Not enough space. Free some space, then try again.</string>
    <string name="failure_storage_words">Not enough space to add the word meanings. Free some space, then try again.</string>
    <string name="failure_save">Could not save. Your phone\'s storage may be full.</string>
</resources>
