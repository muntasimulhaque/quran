<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The reader approved one network use and only one: content from this
         project's own release page, on their word. The chosen language's
         translation and tafsir arrive for that language, a word list arrives
         with the reading toggle that turns it on, and a recitation package
         arrives for one surah after Play and the shown size. No analytics, no
         other host, nothing at launch. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The daily reminder, and the only reason for an exact alarm in this
         app: the reader chooses a minute, and the reminder is a promise that
         it arrives at that minute even on a phone that is locked and idle
         then. Before Android 14 the install grants this permission; from
         Android 14 it starts out denied, and the app asks for it once, in
         the phone's own screen, at the two moments the reminder is set.
         USE_EXACT_ALARM is not declared and must not be: Play accepts it for
         an alarm clock or a calendar only, and rejected the 3.9 build over
         it. The grant is no row in the settings hub, and the reminder wears
         no alarm icon (owner decision). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- A reboot takes every alarm with it, and a reminder that waits for the
         next app open after a restart is not the reminder the reader set, so
         the boot receiver below puts the alarm back (owner decision). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Nothing of the reader's leaves the phone. allowBackup="false" refuses
         every backup on Android 11 and below; from Android 12 that attribute
         alone does not stop a device-to-device transfer, so dataExtractionRules
         carries the refusal there. There is no export, no import, and no other
         door (owner decision, this session). The back-callback attribute is
         read only from Android 13 on, and older platforms ignore it, so its
         API level warning is suppressed here rather than hidden in a baseline. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Quran"
        tools:ignore="UnusedAttribute">
        <!-- The reading's one activity. uiMode is deliberately not in its
             configChanges: a theme change is the one configuration change this
             app does not handle itself. The interface language is applied in
             attachBaseContext through a context derived with
             createConfigurationContext, a snapshot taken when the window is
             built, and nothing in the app recomposes the page when the phone's
             own day and night turn over underneath it. So the app promised to
             follow the system dark mode and did not: at ten in the morning,
             the phone in its day colours, the app on the night page it was
             launched with, and the switch on (owner report, 37th session).
             Leaving uiMode to the platform makes the change do what it does
             everywhere else, which is recreate the window and draw the other
             half of the themes. Nothing is lost in the recreation: the view
             model keeps the reading's place, and the open settings page is
             rememberSaveable, which is the same road a language choice
             already takes. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A link to one verse, quran://ayah/2:255. The activity reads
                 the scheme, the host, and the path, and a link that names
                 nothing is ignored rather than guessed at. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="quran" android:host="ayah" />
            </intent-filter>

            <!-- The three home-screen shortcuts, drawn from this app's own
                 doors and never from a dead one. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The ayah card leaves as a PNG through this provider: one folder
             of the cache, read-granted to the app the reader picks in the
             chooser, exported to nobody. It adds no permission and no new
             dependency; androidx.core has always been here. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- The daily reminder, fired by the alarm the app itself set. The
             alarm's pending intent names this receiver directly, so the
             receiver is not exported and carries no intent filter: nothing
             outside the app can reach it, and it needs no permission of its
             own. -->
        <receiver
            android:name=".daily.DailyAyahScheduler$Receiver"
            android:exported="false" />

        <!-- The reminder's re-arm after the things that take an alarm away:
             a boot, an app update, a clock change, or a time zone change. A
             reboot is the one that mattered: an alarm does not survive one,
             and a morning lost to a restart is the same missed reminder the
             exact alarm exists to prevent (owner report). The system is the
             only sender of these protected broadcasts, so the receiver is
             not exported. -->
        <receiver
            android:name=".daily.DailyAyahBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
