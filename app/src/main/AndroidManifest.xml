<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The reader approved one network use and only one: downloading
         recitation packages from the project's own release page, when they ask
         to play a surah. No analytics, no other host, nothing at launch. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Quran">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The ayah card leaves as a PNG through this provider: one folder
             of the cache, read-granted to the app the reader picks in the
             chooser, exported to nobody. It adds no permission and no new
             dependency; androidx.core has always been here. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- The daily reminder, fired by the alarm the app itself set. The
             alarm's pending intent names this receiver directly, so the
             receiver is not exported and carries no intent filter: nothing
             outside the app can reach it, and it needs no permission of its
             own. -->
        <receiver
            android:name=".daily.DailyAyahScheduler$Receiver"
            android:exported="false" />

    </application>
</manifest>
