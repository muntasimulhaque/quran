<resources>
    <!-- The three frozen names (D-001): the app is named Quran in every
         language, and the Arabic title and its English are the same on every
         screen. translatable="false" is the freeze written where lint can
         see it. -->
    <string name="app_name" translatable="false">Quran</string>

    <string name="first_paint_title" translatable="false">القرآن</string>
    <string name="first_paint_subtitle" translatable="false">The Noble Book</string>
    <string name="reader_fallback_title">Quran</string>
    <string name="surah_fallback_name">Surah %1$d</string>
    <string name="juz_label">Juz %1$d</string>

    <!-- The one screen before the reading, shown once. Each language is named
         in its own script there, so these lines only carry the question. -->
    <string name="welcome_title">Choose your language</string>
    <string name="welcome_body">The app, the translation, the tafsir, and the word meanings all read in the language you choose.</string>
    <string name="welcome_later">You can change this any time in Settings.</string>
    <string name="welcome_suggested">Suggested</string>

    <string name="hint_long_press_ayah">Press and hold any ayah for its actions</string>

    <string name="action_browse">Browse the Quran</string>
    <string name="action_search">Search</string>
    <string name="action_settings">Settings</string>
    <string name="action_save">Save</string>
    <string name="action_play">Play</string>
    <string name="action_share">Share</string>
    <string name="action_more">More</string>
    <string name="action_retry">Retry</string>
    <string name="action_close">Close</string>
    <string name="action_cancel">Cancel</string>


    <!-- The reader's own pack progress. The name carries the module that
         draws it, so two modules can never both own a `pack_downloading`
         with different format arguments and have one silently replace the
         other at merge time. -->
    <string name="reader_pack_preparing">Preparing…</string>
    <string name="reader_pack_downloading">Downloading %1$d%% · %2$s</string>
    <string name="pack_download_failed">Could not download. Check your connection.</string>

    <string name="playback_continue_to">Continue to %1$s · %2$s</string>
    <string name="playback_offer">%1$s · %2$s</string>

    <string name="content_problem_title">The Quran text could not be opened</string>
    <string name="content_problem_body">Something on this device stopped the app from reading its own content. Nothing has been lost: your saved ayahs and settings are untouched.</string>
    <string name="content_problem_retry">Try again</string>
