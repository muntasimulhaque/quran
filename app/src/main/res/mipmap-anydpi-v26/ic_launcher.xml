<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's mark: an open book on its rehal, drawn for this app as
  uniform line art in the theme's ink on the theme's paper, book and
  stand alike (owner decision: the owner's own reference for the
  drawing, and one ink at 14.3:1 on the warm white page, since the thin
  ornament gold read as a shadow at 24 to 48 dp). The mark is the same drawing in the
  launcher, on the store page, in the share card, and in the feature
  graphic. The background is the paper alone, so the layers can be
  masked to any shape, and the monochrome layer carries the book's
  silhouette so a themed home screen keeps the shape.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
