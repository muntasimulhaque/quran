<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's mark: the medallion of the cover the app was built from, its
  gold ornament and its calligraphy traced from the cover itself, set on
  the app's own blue ink. The mark is the same drawing in the launcher, in
  the reminder's small icon, on the store page, and in the feature graphic.
  The background is the ink alone, so the layers can be masked to any
  shape, and the monochrome layer carries the medallion's silhouette,
  sturdier than the mark, so a themed home screen keeps the shape (owner
  decision). The medallion is sized to about 48 percent of the icon canvas
  on every surface that shows it, so a launcher's mask leaves air around
  the gold instead of the mark filling the tile (owner decision, 4.9).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_fg" />
    <monochrome android:drawable="@mipmap/ic_launcher_mono" />
</adaptive-icon>
