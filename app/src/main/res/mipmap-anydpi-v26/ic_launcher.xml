<?xml version="1.0" encoding="utf-8"?>
<!--
  The qaf mark: the letter that begins the word Quran, drawn the way a
  reed pen draws it, the loop thinning where the nib runs flat and
  swelling where it bites, the tail tapering to a flat pen cut, and the
  two dots as a scribe's rhombi in the gold of an illuminated initial.
  The field is deep ink with a quiet light behind the letter. The
  monochrome layer carries the same silhouette a little sturdier, so a
  themed home screen keeps the mark (owner decision, D-126).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_fg" />
    <monochrome android:drawable="@mipmap/ic_launcher_mono" />
</adaptive-icon>
