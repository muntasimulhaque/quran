<?xml version="1.0" encoding="utf-8"?>
<!--
  The manuscript mark: an illuminated mushaf opening on lapis, drawn from the
  physical page, a carpet page facing the first page of Al-Fatihah. The store
  icon rings it with the cover's own ruled border; the adaptive layers carry
  the book alone, on the lapis field. The monochrome layer lets Android 13
  and later draw a themed icon from the same drawing, so the app belongs on a
  themed home screen too.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_fg" />
    <monochrome android:drawable="@mipmap/ic_launcher_mono" />
</adaptive-icon>
