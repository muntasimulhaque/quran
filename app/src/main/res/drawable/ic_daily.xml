<?xml version="1.0" encoding="utf-8"?>
<!--
  The reminder's small icon: the app's own mark, the eight point manuscript
  star. It is drawn the way a manuscript constructs the same star, as two
  overlapping squares, the second turned on its corner, in one outline. It is
  deliberately not a bell or a clock: every other reminder in the shade wears
  one of those, and this one is the app's own mark. Only the alpha channel is
  read, and the system tints the silhouette with the notification color on
  every skin.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineJoin="miter"
        android:pathData="M6.6,6.6 L17.4,6.6 L17.4,17.4 L6.6,17.4 Z
        M12,3.4 L20.6,12.0 L12,20.6 L3.4,12.0 Z" />
</vector>
