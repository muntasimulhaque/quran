<!--
  The reminder's small icon: the app's own mark, the illuminated open book,
  drawn bolder and plainer than the launcher glyph so the spread, the gutter,
  and the gold frames survive the status bar's size. It is deliberately not a
  bell or a clock: every other reminder in the shade wears one of those, and
  this one is the app's own mark. Only the alpha channel is read, and the
  system tints the silhouette with the notification color on every skin
  (owner decision).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The spread: two ivory pages meeting in a gutter, drawn as one
         silhouette the status bar can tint. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,7.4 C10.6,6.7 8.8,6.4 6.9,6.5 C5.6,6.55 4.8,7.3 4.85,8.6 L5.1,17.4 C5.15,18.6 6.2,19.5 7.4,19.3 C9.0,19.0 10.6,19.0 12,19.4 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,7.4 C13.4,6.7 15.2,6.4 17.1,6.5 C18.4,6.55 19.2,7.3 19.15,8.6 L18.9,17.4 C18.85,18.6 17.8,19.5 16.6,19.3 C15.0,19.0 13.4,19.0 12,19.4 Z" />
    <!-- The gutter, a notch of absence the two pages do not meet at, so the
         shape reads as an open book rather than a slab. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="0.7"
        android:pathData="M12,7.6 L12,19.2" />
</vector>