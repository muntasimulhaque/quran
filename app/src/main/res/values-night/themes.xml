<?xml version="1.0" encoding="utf-8"?>
<!--
  The window that the system shows before the app draws its own first frame.
  A reader whose system is dark and whose page is dark must never be flashed
  with a white sheet on the way in.
-->
<resources>
    <style name="Theme.Quran" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
