<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's three home-screen shortcuts: back to the reading, the search
  field, and the day's ayah. Each is the same door the app already has, and
  the daily one asks for the same verse the reminder would have shown, from
  the same deck. The mark is the app's own drawing, never a stock glyph.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute">
    <shortcut
        android:shortcutId="continue"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mark"
        android:shortcutShortLabel="@string/shortcut_continue_short"
        android:shortcutLongLabel="@string/shortcut_continue_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="io.github.muntasimulhaque.quran"
            android:targetClass="io.github.muntasimulhaque.quran.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mark"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="io.github.muntasimulhaque.quran"
            android:targetClass="io.github.muntasimulhaque.quran.MainActivity">
            <extra
                android:name="io.github.muntasimulhaque.quran.extra.OPEN"
                android:value="search" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="daily"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mark"
        android:shortcutShortLabel="@string/shortcut_daily_short"
        android:shortcutLongLabel="@string/shortcut_daily_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="io.github.muntasimulhaque.quran"
            android:targetClass="io.github.muntasimulhaque.quran.MainActivity">
            <extra
                android:name="io.github.muntasimulhaque.quran.extra.OPEN"
                android:value="daily" />
        </intent>
    </shortcut>
</shortcuts>
